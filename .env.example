# TradeAI — Environment Template
# Copy to .env and fill in real values. .env is gitignored — NEVER commit secrets.
#
# Lookup order (highest wins): existing os.environ > .env.vault > .env > env.bat
# See secrets_loader.py for details.

# ── Secrets (REQUIRED for live operation) ─────────────────────────────────────
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ── Execution mode (PAPER until N≥30 closed paper signals collected) ──────────
EXECUTION_MODE=PAPER

# ── Optional: capital for position sizing (defaults to 1000) ──────────────────
# YOUR_CAPITAL=1000.0

# ── Optional: tunable overrides — see config.py for the full list ─────────────
# SIGNAL_COOLDOWN=40
# LIVE_FVG_MIN_QUALITY=HIGH
# CHECK_INTERVAL=90

# ── Optional: SMTP secondary alert path (watchdog) ────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=alerts@yourdomain.com
# SMTP_PASS=app-specific-password
# SMTP_TO=oncall@yourdomain.com

# ── Optional: encrypted secrets via dotenv-vault ──────────────────────────────
# If you generate a .env.vault via `npx dotenv-vault encrypt`, set DOTENV_KEY
# below to decrypt at runtime. Requires `pip install python-dotenv-vault`.
# DOTENV_KEY=dotenv://:key_xxxx@dotenv.local/vault/.env.vault?environment=production
