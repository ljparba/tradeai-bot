# TradeAI Autonomous Explorer — per-session overrides
# Copy to /home/tradeai/TradeAI/.env.explorer and edit before starting a session:
#     cp deploy/env.explorer.example .env.explorer
#     nano .env.explorer
#     sudo systemctl start tradeai-explorer
#
# If this file is absent, the explorer falls back to its built-in defaults
# (50 trials, study-name "nightly_explorer") — see scripts/autonomous_explorer.py.

# ──────────────────────────────────────────────────────────────────────────
# SESSION BASICS
# ──────────────────────────────────────────────────────────────────────────

# How many Optuna trials to run this session.
# ~20 min per trial on the VPS → 50 trials = ~16h. 30 = ~10h. 100 = ~33h.
EXPLORER_TRIALS=50

# Optional study name. Reuse the same name to RESUME a prior session
# (Optuna study DB is persistent at data/optuna_study.db).
# Change the name to start a fresh independent study.
EXPLORER_STUDY_NAME=nightly_explorer

# ──────────────────────────────────────────────────────────────────────────
# PASS-GATE OVERRIDES (advanced — leave commented unless intentional)
# ──────────────────────────────────────────────────────────────────────────
# The defaults below match the "high-quality / low-frequency" Run-168 profile:
# they find configs with high CPCV WR (≥60%) and ≥30 signals/365d.
# To search a DIFFERENT region (e.g. "high-frequency / moderate-WR"),
# loosen the gates by uncommenting + adjusting:

# EXPLORER_N_MIN=30        # min signals/365d to consider PASS (default 30 ≈ 2.5/mo)
# EXPLORER_WR_MIN=60.0     # min CPCV mean WR % (default 60.0)
# EXPLORER_Q05_MIN=50.0    # min worst-fold WR % (default 50.0)
# EXPLORER_DSR_MIN=95.0    # min Deflated Sharpe Ratio % (default 95.0)

# ── Example: "high-frequency search" profile (15+ signals/mo target) ──
# To find configs that emit ~15+ signals/month at lower WR but potentially
# similar net profit per year, use these values:
#
# EXPLORER_STUDY_NAME=high_freq_search_2026
# EXPLORER_N_MIN=180       # >= 180/365d = >= 15/mo
# EXPLORER_WR_MIN=55.0     # accept slightly lower WR
# EXPLORER_Q05_MIN=45.0    # accept weaker worst-fold
# EXPLORER_DSR_MIN=80.0    # less strict selection-bias correction
#
# This searches a DIFFERENT region of the parameter space than the default
# profile. Run-168 (the current canonical baseline) is unaffected — the
# Pareto archive accumulates candidates from BOTH profiles.

# ──────────────────────────────────────────────────────────────────────────
# SIGNAL-COUNT BONUS (cycle-7 fix — bias Optuna toward higher frequency)
# ──────────────────────────────────────────────────────────────────────────
# Optuna's objective function is now `cpcv_mean + alpha * log(n)` instead
# of just `cpcv_mean`. Before this fix, Optuna actively converged AWAY
# from high-frequency configs because they slightly hurt WR. With LIVE
# clearance gated on 30 closed paper signals at ~2.88 sigs/month (~10
# months to gate), the real operator goal is "more signals at acceptable
# WR" — not "max WR".
#
# alpha=0     → reverts to pure-WR optimization (legacy behavior)
# alpha=2.0   → DEFAULT — modest tilt toward frequency, preserves quality
# alpha=5.0   → moderately aggressive frequency hunt
# alpha=10.0  → aggressive — accepts noticeable WR drops for big n gains
#
# Calibration table (vs Run-81 baseline n=35, WR=70):
#   alpha=2.0  → n=80 accepted down to WR≈68.4%, n=120 to WR≈67.5%
#   alpha=5.0  → n=80 accepted down to WR≈65.9%, n=120 to WR≈63.8%
#   alpha=10.0 → n=120 accepted down to WR≈57.7%
#
# EXPLORER_N_BONUS_ALPHA=2.0

# ──────────────────────────────────────────────────────────────────────────
# SEARCH SPACE PROFILE (2026-05-27 — replaces legacy 5M-only default)
# ──────────────────────────────────────────────────────────────────────────
# The explorer can tune EITHER the CRT scanner's params OR the 5M_SWEEP
# scanner's params — but NOT both at once (search space dim explosion +
# misattribution risk). Pick one profile per session via EXPLORER_SEARCH_SPACE.
#
# EXPLORER_SEARCH_SPACE=crt (DEFAULT, 2026-05-27 onward)
#   Search space (8 CRT params):
#     CRT_TP1_MODE             — categorical: dynamic / fixed_1r / min_1r
#     CRT_TP2_RR               — float 1.2-2.5 (step 0.1)
#     CRT_TP3_RR               — float 1.8-3.5 (step 0.1)
#     H4_CRT_C2_LOOKBACK       — int 4-20 (step 2) → 16-80h reference window
#     WYCKOFF_PHASE_FILTER     — categorical: off / loose (strict locked anti-pattern)
#     CRT_REQUIRE_1H_TREND     — boolean: 0 / 1
#     BACKTEST_BIAS_4H_GATE    — categorical: none / loose / strict
#     CRT_FORWARD_BARS         — categorical: 288 / 576 / 864 (24h/48h/72h window)
#   Auto-pins scanner: ENABLE_5M_SWEEP=0, ENABLE_H4_CRT=1
#
# EXPLORER_SEARCH_SPACE=5m (FALLBACK — legacy pre-CRT search space)
#   Search space (8 5M_SWEEP params):
#     ICT_SWEEP_LOOKBACK, ICT_MSS_HORIZON, ICT_FVG_MIN_GAP, DEALING_RANGE_LOOKBACK,
#     BACKTEST_BIAS_4H_GATE, BACKTEST_TREND_1H_GATE,
#     BACKTEST_FVG_MIN_QUALITY, BACKTEST_MSS_MIN_QUALITY
#   Auto-pins scanner: ENABLE_5M_SWEEP=1, ENABLE_H4_CRT=0

# EXPLORER_SEARCH_SPACE=crt    # default — tunes CRT scanner params

# ──────────────────────────────────────────────────────────────────────────
# SCANNER TOGGLES (Fix B-1, 2026-05-27)
# ──────────────────────────────────────────────────────────────────────────
# Trial subprocesses pin scanner kill switches independently of the
# operator's paper-soak `.env`. Defaults are derived from EXPLORER_SEARCH_SPACE
# above; only set these explicitly if you want a joint-mode (both-on)
# attribution-blend experiment.

# EXPLORER_ENABLE_5M_SWEEP=0   # default depends on EXPLORER_SEARCH_SPACE
# EXPLORER_ENABLE_H4_CRT=1     # default depends on EXPLORER_SEARCH_SPACE
#
# Operator's live PAPER `.env` is unaffected by these knobs — they only
# override the trial subprocess env, never the parent bot's runtime.

# ──────────────────────────────────────────────────────────────────────────
# RECOMMENDED CRT-SEARCH PROFILE (2026-05-27)
# ──────────────────────────────────────────────────────────────────────────
# For a CRT param hunt (the typical use case in CRT-soak mode):
#
# EXPLORER_TRIALS=30
# EXPLORER_STUDY_NAME=crt_search_v1_2026_05
# EXPLORER_SEARCH_SPACE=crt
# EXPLORER_N_MIN=100              # CRT is higher-freq than 5M
# EXPLORER_WR_MIN=55.0            # Test A baseline; aim to beat
# EXPLORER_Q05_MIN=45.0
# EXPLORER_DSR_MIN=85.0           # relaxed from 95% — CRT pool is sparse
# EXPLORER_N_BONUS_ALPHA=2.0      # default — modest frequency bias
#
# Optionally restore strict gates as CRT data accumulates:
# EXPLORER_WR_MIN=58.0  EXPLORER_DSR_MIN=95.0
