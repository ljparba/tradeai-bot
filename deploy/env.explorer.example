# TradeAI Autonomous Explorer — per-session overrides
# Copy to /home/tradeai/TradeAI/.env.explorer and edit before starting a session:
#     cp deploy/env.explorer.example .env.explorer
#     nano .env.explorer
#     sudo systemctl start tradeai-explorer
#
# If this file is absent, the explorer falls back to its built-in defaults
# (50 trials, study-name "nightly_explorer") — see scripts/autonomous_explorer.py.

# How many Optuna trials to run this session.
# ~11 min per trial → 50 trials = ~9 hours. 30 = ~5.5h. 100 = ~18h.
EXPLORER_TRIALS=50

# Optional study name. Reuse the same name to RESUME a prior session
# (Optuna study DB is persistent at data/optuna_study.db).
# Change the name to start a fresh independent study.
EXPLORER_STUDY_NAME=nightly_explorer
