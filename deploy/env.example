# TradeAI environment configuration
# Copy this to .env on the VPS and fill in real values.
# .env is git-ignored — never commit it.

# ─── Execution mode ────────────────────────────────────────
# PAPER = signals only, no real trading (DEFAULT)
# LIVE  = strict portfolio caps + drawdown halt
EXECUTION_MODE=PAPER

# Required ONLY if EXECUTION_MODE=LIVE (additional safety gate)
# LIVE_MODE_CONFIRMED=YES

# Required ONLY if EXECUTION_MODE=LIVE — your actual account capital
# Default $1000 is rejected by the bot to force explicit configuration
# YOUR_CAPITAL=5000

# ─── Telegram alerts ───────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE
CHAT_ID=YOUR_CHAT_ID_HERE

# ─── Optional: strategy gate overrides ─────────────────────
# Defaults in config.py / ict_engine.py are the Run-168 baseline.
# Override here only if you want session-specific testing.
# BACKTEST_BIAS_4H_GATE=none
# BACKTEST_TREND_1H_GATE=strict
# BACKTEST_FVG_MIN_QUALITY=HIGH
# BACKTEST_MSS_MIN_QUALITY=LOW
# ICT_SWEEP_LOOKBACK=20
